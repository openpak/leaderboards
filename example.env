# Leaderboards service (block 20210 in ports.md). Copy to .env, fill in, never commit .env.
LEADERBOARDS_DATABASE_URL=postgres://postgres:test@127.0.0.1:54329/leaderboards?sslmode=disable
LEADERBOARDS_HTTP_ADDR=127.0.0.1:20210
LEADERBOARDS_GRPC_ADDR=127.0.0.1:20211
LEADERBOARDS_METRICS_ADDR=127.0.0.1:20212
# The account core (its gRPC on +1 of its block) and the credential this service presents there.
# Friend lists come from it; "leaderboard.record" events land on its stream.
LEADERBOARDS_CORE_ADDRESS=127.0.0.1:20001
LEADERBOARDS_CORE_INTERNAL_KEY=
# What the console adapters (gRPC x-internal-key) and the erasure finaliser (X-Internal-Key) present here.
LEADERBOARDS_INTERNAL_KEY=
# Optional: rewards events ("leaderboard_new_best.<title>"). Off while unset. The rewards
# service must define that metric first (unknown metrics are rejected).
# REWARDS_EVENTS_URL=http://openpak-rewards:20180
# REWARDS_EVENTS_KEY=
